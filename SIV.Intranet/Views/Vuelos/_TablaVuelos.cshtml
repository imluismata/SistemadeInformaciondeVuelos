@using SIV.Intranet.Models
@model IReadOnlyList<SIV.Intranet.Models.VueloApi>
@{
    // Reutilizable por ambos recuadros (activos y completados) para no
    // repetir la estructura de la tabla (DRY).
    var puedeOperar = User.IsInRole("OperadorVuelos") || User.IsInRole("Administrador");
    var mensajeVacio = ViewData["MensajeVacio"]?.ToString() ?? "No hay vuelos.";
}

@if (!Model.Any())
{
    <div class="p-8 text-center text-on-surface-variant">@mensajeVacio</div>
}
else
{
    <div class="overflow-x-auto">
        <table class="w-full text-center border-collapse">
            <thead>
                <tr class="bg-surface-container-low border-b border-outline-variant">
                    <th class="px-6 py-3 text-sm text-on-surface-variant uppercase tracking-wider text-center">Vuelo</th>
                    <th class="px-6 py-3 text-sm text-on-surface-variant uppercase tracking-wider text-center">Salida</th>
                    <th class="px-6 py-3 text-sm text-on-surface-variant uppercase tracking-wider text-center">Llegada</th>
                    <th class="px-6 py-3 text-sm text-on-surface-variant uppercase tracking-wider text-center">Puerta</th>
                    <th class="px-6 py-3 text-sm text-on-surface-variant uppercase tracking-wider text-center">Estado</th>
                    <th class="px-6 py-3 text-sm text-on-surface-variant uppercase tracking-wider text-center">Acciones</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-outline-variant">
                @foreach (var v in Model)
                {
                    <tr class="data-row">
                        <td class="px-6 py-3.5">
                            <a asp-action="Detalle" asp-route-id="@v.Id"
                               class="font-mono font-semibold text-primary hover:underline">@v.Numero</a>
                        </td>
                        <td class="px-6 py-3.5 font-mono">@v.HorarioSalida.ToString("dd/MM HH:mm")</td>
                        <td class="px-6 py-3.5 font-mono">@v.HorarioLlegada.ToString("dd/MM HH:mm")</td>
                        <td class="px-6 py-3.5">
                            <span class="bg-surface-container px-3 py-1 rounded font-semibold">@(string.IsNullOrEmpty(v.Puerta) ? "—" : v.Puerta)</span>
                        </td>
                        <td class="px-6 py-3.5">
                            <span class="status-pill @EstadoVueloEstilo.ClasePill(v.EstadoActual)">@v.EstadoActual</span>
                        </td>
                        @* Acción explícita: el icono refleja lo que el rol permite hacer. *@
                        <td class="px-6 py-3.5">
                            <a asp-action="Detalle" asp-route-id="@v.Id"
                               title="@(puedeOperar ? $"Gestionar el vuelo {v.Numero}" : $"Ver detalle del vuelo {v.Numero}")"
                               class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-outline-variant text-on-surface-variant hover:bg-surface-container hover:text-primary transition-colors">
                                <span class="material-symbols-outlined text-base">@(puedeOperar ? "settings" : "visibility")</span>
                                <span class="text-sm">@(puedeOperar ? "Gestionar" : "Ver")</span>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="px-6 py-3 bg-surface-container-low border-t border-outline-variant text-sm text-on-surface-variant">
        Mostrando @Model.Count vuelo(s)
    </div>
}
