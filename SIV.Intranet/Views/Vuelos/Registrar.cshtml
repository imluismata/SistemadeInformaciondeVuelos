@model SIV.Intranet.Models.RegistrarVueloViewModel
@{
    ViewData["Title"] = "Nuevo vuelo";
    ViewData["Subtitulo"] = "Registrar un vuelo en la programación";
}

<div class="bg-surface-container-lowest border border-outline-variant rounded-xl shadow-sm overflow-hidden max-w-3xl">
    <div class="p-6 border-b border-outline-variant">
        <h3 class="text-lg font-bold text-primary">Datos del vuelo</h3>
        <p class="text-sm text-on-surface-variant">El vuelo se registra en estado <strong>Programado</strong>.</p>
    </div>

    <form asp-action="Registrar" method="post" class="p-6 space-y-5">
        <div asp-validation-summary="ModelOnly" class="text-sm text-secondary bg-red-50 border border-red-200 rounded-lg px-4 py-3"></div>

        <div>
            <label asp-for="Numero" class="block text-sm font-medium text-on-surface-variant mb-1"></label>
            <input asp-for="Numero" placeholder="Ej. AA 949"
                   class="w-full rounded-lg border border-outline-variant px-4 py-2.5 focus:ring-2 focus:ring-primary-container outline-none" />
            <span asp-validation-for="Numero" class="text-xs text-secondary"></span>
        </div>

        <div>
            <label asp-for="AerolineaId" class="block text-sm font-medium text-on-surface-variant mb-1"></label>
            <select asp-for="AerolineaId" asp-items="Model.Aerolineas"
                    class="w-full rounded-lg border border-outline-variant px-4 py-2.5 focus:ring-2 focus:ring-primary-container outline-none">
                <option value="">— Selecciona una aerolínea —</option>
            </select>
            <span asp-validation-for="AerolineaId" class="text-xs text-secondary"></span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
                <label asp-for="AeropuertoOrigenId" class="block text-sm font-medium text-on-surface-variant mb-1"></label>
                <select asp-for="AeropuertoOrigenId" asp-items="Model.Aeropuertos"
                        class="w-full rounded-lg border border-outline-variant px-4 py-2.5 focus:ring-2 focus:ring-primary-container outline-none">
                    <option value="">— Origen —</option>
                </select>
                <span asp-validation-for="AeropuertoOrigenId" class="text-xs text-secondary"></span>
            </div>
            <div>
                <label asp-for="AeropuertoDestinoId" class="block text-sm font-medium text-on-surface-variant mb-1"></label>
                <select asp-for="AeropuertoDestinoId" asp-items="Model.Aeropuertos"
                        class="w-full rounded-lg border border-outline-variant px-4 py-2.5 focus:ring-2 focus:ring-primary-container outline-none">
                    <option value="">— Destino —</option>
                </select>
                <span asp-validation-for="AeropuertoDestinoId" class="text-xs text-secondary"></span>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div>
                <label asp-for="HorarioSalida" class="block text-sm font-medium text-on-surface-variant mb-1"></label>
                <input asp-for="HorarioSalida" type="datetime-local"
                       class="w-full rounded-lg border border-outline-variant px-4 py-2.5 focus:ring-2 focus:ring-primary-container outline-none" />
                <span asp-validation-for="HorarioSalida" class="text-xs text-secondary"></span>
            </div>
            <div>
                <label asp-for="HorarioLlegada" class="block text-sm font-medium text-on-surface-variant mb-1"></label>
                <input asp-for="HorarioLlegada" type="datetime-local"
                       class="w-full rounded-lg border border-outline-variant px-4 py-2.5 focus:ring-2 focus:ring-primary-container outline-none" />
                <span asp-validation-for="HorarioLlegada" class="text-xs text-secondary"></span>
            </div>
            <div>
                <label asp-for="Puerta" class="block text-sm font-medium text-on-surface-variant mb-1"></label>
                <input asp-for="Puerta" placeholder="Ej. B12"
                       class="w-full rounded-lg border border-outline-variant px-4 py-2.5 focus:ring-2 focus:ring-primary-container outline-none" />
            </div>
        </div>

        <div class="flex gap-3 pt-2">
            <button type="submit" class="bg-primary text-on-primary rounded-lg px-6 py-2.5 font-semibold hover:opacity-90 transition-opacity">
                Registrar vuelo
            </button>
            <a asp-action="Index" class="border border-outline text-on-surface rounded-lg px-6 py-2.5 font-semibold hover:bg-surface-container transition-colors">
                Cancelar
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
