@using SIV.Intranet.Models
@model IReadOnlyList<SIV.Intranet.Models.VueloApi>
@{
    ViewData["Title"] = "Gestión de Vuelos";
    ViewData["Subtitulo"] = "Estado en tiempo real de SDQ";
}

<div class="bg-surface-container-lowest border border-outline-variant rounded-xl shadow-sm overflow-hidden">
    <div class="p-6 border-b border-outline-variant flex justify-between items-center">
        <h3 class="text-lg font-bold text-primary">Programación de vuelos</h3>
        @if (User.IsInRole("OperadorVuelos") || User.IsInRole("Administrador"))
        {
            <a asp-controller="Vuelos" asp-action="Registrar"
               class="flex items-center gap-1 px-4 py-2 bg-primary text-on-primary rounded-lg text-sm hover:opacity-90 transition-all">
                <span class="material-symbols-outlined text-sm">add</span> Nuevo vuelo
            </a>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="p-8 text-center text-on-surface-variant">No hay vuelos registrados.</div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-surface-container-low border-b border-outline-variant">
                        <th class="px-6 py-3 text-sm text-on-surface-variant uppercase tracking-wider">Vuelo</th>
                        <th class="px-6 py-3 text-sm text-on-surface-variant uppercase tracking-wider">Salida</th>
                        <th class="px-6 py-3 text-sm text-on-surface-variant uppercase tracking-wider">Llegada</th>
                        <th class="px-6 py-3 text-sm text-on-surface-variant uppercase tracking-wider">Puerta</th>
                        <th class="px-6 py-3 text-sm text-on-surface-variant uppercase tracking-wider">Estado</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-outline-variant">
                    @foreach (var v in Model)
                    {
                        <tr class="hover:bg-surface-container-low transition-colors">
                            <td class="px-6 py-4 font-mono font-semibold text-on-surface">@v.Numero</td>
                            <td class="px-6 py-4 font-mono">@v.HorarioSalida.ToString("dd/MM HH:mm")</td>
                            <td class="px-6 py-4 font-mono">@v.HorarioLlegada.ToString("dd/MM HH:mm")</td>
                            <td class="px-6 py-4">
                                <span class="bg-surface-container px-3 py-1 rounded font-semibold">@(string.IsNullOrEmpty(v.Puerta) ? "—" : v.Puerta)</span>
                            </td>
                            <td class="px-6 py-4">
                                <span class="status-pill @EstadoVueloEstilo.ClasePill(v.EstadoActual)">@v.EstadoActual</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="px-6 py-3 bg-surface-container-low border-t border-outline-variant text-sm text-on-surface-variant">
            Mostrando @Model.Count vuelo(s)
        </div>
    }
</div>
