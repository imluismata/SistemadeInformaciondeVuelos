@using SIV.Intranet.Models
@using Microsoft.AspNetCore.Mvc.ViewFeatures
@model SIV.Intranet.Models.VuelosFiltroViewModel
@{
    ViewData["Title"] = "Gestión de Vuelos";
    ViewData["Subtitulo"] = "Estado en tiempo real de SDQ";

    var puedeOperar = User.IsInRole("OperadorVuelos") || User.IsInRole("Administrador");

    // Los vuelos finalizados (Completado o Cancelado) se separan de los
    // activos para no mezclar la operación en curso con lo ya terminado.
    var estadosFinales = new[] { "Completado", "Cancelado" };
    var activos = Model.Vuelos.Where(v => !estadosFinales.Contains(v.EstadoActual)).ToList();
    var finalizados = Model.Vuelos.Where(v => estadosFinales.Contains(v.EstadoActual)).ToList();

    var vdActivos = new ViewDataDictionary(ViewData) { ["MensajeVacio"] = "No hay vuelos activos." };

    var resumen = ResumenVuelos.DesdeVuelos(Model.Vuelos);
}

<!-- Filtro de consulta (CU-VUE-03) -->
<div class="bg-surface-container-lowest border border-outline-variant rounded-xl shadow-sm p-6">
    <form asp-action="Index" method="get" class="grid grid-cols-1 md:grid-cols-5 gap-4 items-end">
        <div>
            <label asp-for="AerolineaId" class="block text-sm font-medium text-on-surface-variant mb-1"></label>
            <select asp-for="AerolineaId" asp-items="Model.Aerolineas"
                    class="w-full rounded-lg border border-outline-variant px-3 py-2 outline-none focus:ring-2 focus:ring-primary-container">
                <option value="">Todas</option>
            </select>
        </div>
        <div>
            <label asp-for="Estado" class="block text-sm font-medium text-on-surface-variant mb-1"></label>
            <select asp-for="Estado"
                    class="w-full rounded-lg border border-outline-variant px-3 py-2 outline-none focus:ring-2 focus:ring-primary-container">
                <option value="">Todos</option>
                @foreach (var estado in EstadosVuelo.Todos)
                {
                    <option value="@estado">@estado</option>
                }
            </select>
        </div>
        <div>
            <label asp-for="FechaDesde" class="block text-sm font-medium text-on-surface-variant mb-1"></label>
            <input asp-for="FechaDesde" type="date"
                   class="w-full rounded-lg border border-outline-variant px-3 py-2 outline-none focus:ring-2 focus:ring-primary-container" />
        </div>
        <div>
            <label asp-for="FechaHasta" class="block text-sm font-medium text-on-surface-variant mb-1"></label>
            <input asp-for="FechaHasta" type="date"
                   class="w-full rounded-lg border border-outline-variant px-3 py-2 outline-none focus:ring-2 focus:ring-primary-container" />
        </div>
        <div class="flex gap-2">
            <button type="submit" class="flex-grow bg-primary text-on-primary rounded-lg px-4 py-2 font-semibold hover:opacity-90 transition-opacity">
                Filtrar
            </button>
            <a asp-action="Index" class="border border-outline text-on-surface rounded-lg px-4 py-2 font-semibold hover:bg-surface-container transition-colors">
                Limpiar
            </a>
        </div>
    </form>
</div>

<!-- Fila de KPIs (calculados de los datos reales) -->
<div class="grid grid-cols-2 md:grid-cols-4 gap-6">
    <div class="bg-surface-container-lowest border border-outline-variant rounded-xl shadow-sm p-5 flex items-center gap-4">
        <div class="w-11 h-11 rounded-lg bg-primary/10 text-primary flex items-center justify-center">
            <span class="material-symbols-outlined">flight</span>
        </div>
        <div>
            <div class="text-2xl font-bold text-on-surface leading-none">@resumen.Total</div>
            <div class="text-sm text-on-surface-variant mt-1">Total de vuelos</div>
        </div>
    </div>

    <div class="bg-surface-container-lowest border border-outline-variant rounded-xl shadow-sm p-5 flex items-center gap-4">
        <div class="w-11 h-11 rounded-lg bg-sky-100 text-sky-700 flex items-center justify-center">
            <span class="material-symbols-outlined">flight_takeoff</span>
        </div>
        <div>
            <div class="text-2xl font-bold text-on-surface leading-none">@resumen.EnVuelo</div>
            <div class="text-sm text-on-surface-variant mt-1">En vuelo</div>
        </div>
    </div>

    <div class="bg-surface-container-lowest border border-outline-variant rounded-xl shadow-sm p-5 flex items-center gap-4">
        <div class="w-11 h-11 rounded-lg bg-amber-100 text-amber-700 flex items-center justify-center">
            <span class="material-symbols-outlined">schedule</span>
        </div>
        <div>
            <div class="text-2xl font-bold text-on-surface leading-none">@resumen.Retrasados</div>
            <div class="text-sm text-on-surface-variant mt-1">Retrasados</div>
        </div>
    </div>

    <div class="bg-surface-container-lowest border border-outline-variant rounded-xl shadow-sm p-5 flex items-center gap-4">
        <div class="w-11 h-11 rounded-lg bg-green-100 text-green-700 flex items-center justify-center">
            <span class="material-symbols-outlined">check_circle</span>
        </div>
        <div>
            <div class="text-2xl font-bold text-on-surface leading-none">@resumen.Completados</div>
            <div class="text-sm text-on-surface-variant mt-1">Completados</div>
        </div>
    </div>
</div>

<!-- Vuelos activos -->
<div class="bg-surface-container-lowest border border-outline-variant rounded-xl shadow-sm overflow-hidden">
    <div class="p-6 border-b border-outline-variant flex justify-between items-center">
        <div>
            <h3 class="text-lg font-bold text-primary">Programación de vuelos</h3>
            <p class="text-sm text-on-surface-variant">Vuelos en operación</p>
        </div>
        @if (puedeOperar)
        {
            <a asp-controller="Vuelos" asp-action="Registrar"
               class="flex items-center gap-1 px-4 py-2 bg-primary text-on-primary rounded-lg text-sm hover:opacity-90 transition-all">
                <span class="material-symbols-outlined text-sm">add</span> Nuevo vuelo
            </a>
        }
    </div>
    <partial name="_TablaVuelos" model="activos" view-data="vdActivos" />
</div>

<!-- Vuelos finalizados: completados o cancelados (solo si hay) -->
@if (finalizados.Any())
{
    <div class="bg-surface-container-lowest border border-outline-variant rounded-xl shadow-sm overflow-hidden">
        <div class="p-6 border-b border-outline-variant flex items-center gap-2">
            <span class="material-symbols-outlined text-on-surface-variant">history</span>
            <div>
                <h3 class="text-lg font-bold text-primary">Vuelos finalizados</h3>
                <p class="text-sm text-on-surface-variant">Historial de vuelos completados y cancelados</p>
            </div>
        </div>
        <partial name="_TablaVuelos" model="finalizados" />
    </div>
}
