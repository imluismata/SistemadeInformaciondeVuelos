@{ Layout = null; }
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>404 · Fuera de radar — Quisqueya Flight Hub</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            min-height: 100vh; display: flex; align-items: center; justify-content: center;
            background: radial-gradient(1200px 600px at 50% -10%, #16204a 0%, #0b1024 55%, #070a17 100%);
            color: #e9edff; font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; padding: 24px;
        }
        .tarjeta { background: rgba(255,255,255,.04); border: 1px solid rgba(178,197,255,.15); border-radius: 20px;
            padding: 44px 40px; max-width: 470px; width: 100%; text-align: center; box-shadow: 0 20px 60px rgba(0,0,0,.45); }
        .radar { width: 150px; height: 150px; margin: 0 auto 8px; position: relative; }
        .radar svg { display: block; }
        .barrido { transform-origin: 75px 75px; animation: girar 3.5s linear infinite; }
        @@keyframes girar { to { transform: rotate(360deg); } }
        .codigo { font-size: .8rem; letter-spacing: .18em; color: #8fb0ff; text-transform: uppercase; margin-bottom: 6px; }
        h1 { font-size: 1.7rem; color: #fff; margin-bottom: 8px; }
        p { color: #aeb6d6; line-height: 1.55; font-size: .98rem; }
        .lectura { margin: 18px auto 0; font-family: ui-monospace, "SF Mono", Menlo, monospace; font-size: .72rem;
            color: #6f79a8; letter-spacing: .05em; border: 1px dashed rgba(178,197,255,.18); border-radius: 10px; padding: 8px 12px; display: inline-block; }
        .acciones { margin-top: 26px; display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
        .btn { text-decoration: none; padding: 11px 22px; border-radius: 12px; font-weight: 600; font-size: .95rem; transition: opacity .15s, background .15s; }
        .btn-primario { background: #b2c5ff; color: #0b1024; } .btn-primario:hover { opacity: .9; }
        .btn-secundario { background: transparent; color: #cdd5f5; border: 1px solid rgba(178,197,255,.3); } .btn-secundario:hover { background: rgba(178,197,255,.08); }
        .pie { margin-top: 20px; font-size: .78rem; color: #6b74a0; }
    </style>
</head>
<body>
    <div class="tarjeta">
        <div class="radar" aria-hidden="true">
            <svg width="150" height="150" viewBox="0 0 150 150" fill="none">
                <circle cx="75" cy="75" r="70" stroke="#2b3566" stroke-width="1.5"/>
                <circle cx="75" cy="75" r="48" stroke="#232c57" stroke-width="1.5"/>
                <circle cx="75" cy="75" r="26" stroke="#232c57" stroke-width="1.5"/>
                <line x1="5" y1="75" x2="145" y2="75" stroke="#232c57" stroke-width="1"/>
                <line x1="75" y1="5" x2="75" y2="145" stroke="#232c57" stroke-width="1"/>
                <!-- Barrido del radar -->
                <g class="barrido">
                    <path d="M75 75 L75 5 A70 70 0 0 1 135 40 Z" fill="url(#sweep)"/>
                </g>
                <!-- Sin blip: un signo de interrogación tenue -->
                <text x="75" y="82" text-anchor="middle" font-size="26" fill="#3a4680" font-family="system-ui" font-weight="700">?</text>
                <defs>
                    <linearGradient id="sweep" x1="75" y1="75" x2="120" y2="30" gradientUnits="userSpaceOnUse">
                        <stop stop-color="#8fb0ff" stop-opacity=".28"/>
                        <stop offset="1" stop-color="#8fb0ff" stop-opacity="0"/>
                    </linearGradient>
                </defs>
            </svg>
        </div>
        <div class="codigo">Error 404 · Página no encontrada</div>
        <h1>Fuera de radar</h1>
        <p>No encontramos lo que buscabas. Este destino no aparece en nuestro radar.</p>
        <div class="lectura">ALTITUD: UNK-000 · RUMBO: PERDIDO</div>
        <div class="acciones">
            <a class="btn btn-primario" href="/">Volver al inicio</a>
            <a class="btn btn-secundario" href="javascript:history.back()">Regresar</a>
        </div>
        <div class="pie">Quisqueya Flight Hub · 404</div>
    </div>
</body>
</html>
