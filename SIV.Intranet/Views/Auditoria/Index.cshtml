@model SIV.Intranet.Models.AuditoriaFiltroViewModel
@{
    ViewData["Title"] = "Auditoría";
    ViewData["Subtitulo"] = "Registro inmutable de las acciones del sistema";

    string ClaseResultado(string resultado) => resultado.Equals("Exitoso", StringComparison.OrdinalIgnoreCase)
        ? "bg-green-100 text-green-700"
        : "bg-red-100 text-red-700";
}

<!-- Filtros -->
<div class="bg-surface-container-lowest border border-outline-variant rounded-xl shadow-sm p-6">
    <form asp-action="Index" method="get" class="grid grid-cols-1 md:grid-cols-5 gap-4 items-end">
        <div>
            <label asp-for="Modulo" class="block text-sm font-medium text-on-surface-variant mb-1"></label>
            <select asp-for="Modulo" class="w-full rounded-lg border border-outline-variant px-3 py-2 outline-none focus:ring-2 focus:ring-primary-container">
                <option value="">Todos</option>
                @foreach (var m in AuditoriaFiltroViewModel.Modulos)
                {
                    <option value="@m">@m</option>
                }
            </select>
        </div>
        <div>
            <label asp-for="Accion" class="block text-sm font-medium text-on-surface-variant mb-1"></label>
            <input asp-for="Accion" placeholder="Ej. CambiarEstado"
                   class="w-full rounded-lg border border-outline-variant px-3 py-2 outline-none focus:ring-2 focus:ring-primary-container" />
        </div>
        <div>
            <label asp-for="Desde" class="block text-sm font-medium text-on-surface-variant mb-1"></label>
            <input asp-for="Desde" type="date"
                   class="w-full rounded-lg border border-outline-variant px-3 py-2 outline-none focus:ring-2 focus:ring-primary-container" />
        </div>
        <div>
            <label asp-for="Hasta" class="block text-sm font-medium text-on-surface-variant mb-1"></label>
            <input asp-for="Hasta" type="date"
                   class="w-full rounded-lg border border-outline-variant px-3 py-2 outline-none focus:ring-2 focus:ring-primary-container" />
        </div>
        <div class="flex gap-2">
            <button type="submit" class="flex-grow bg-primary text-on-primary rounded-lg px-4 py-2 font-semibold hover:opacity-90 transition-opacity">
                Filtrar
            </button>
            <a asp-action="Index" class="border border-outline text-on-surface rounded-lg px-4 py-2 font-semibold hover:bg-surface-container transition-colors">
                Limpiar
            </a>
        </div>
    </form>
</div>

<!-- Resultados -->
<div class="bg-surface-container-lowest border border-outline-variant rounded-xl shadow-sm overflow-hidden">
    <div class="p-6 border-b border-outline-variant flex justify-between items-center">
        <div>
            <h3 class="text-lg font-bold text-primary">Registros</h3>
            <p class="text-sm text-on-surface-variant">@Model.Registros.Count registro(s) · orden descendente por fecha</p>
        </div>
        <span class="flex items-center gap-1 text-xs text-on-surface-variant">
            <span class="material-symbols-outlined text-sm">lock</span> Solo lectura
        </span>
    </div>

    @if (!Model.Registros.Any())
    {
        <div class="p-8 text-center text-on-surface-variant">No hay registros para los filtros aplicados.</div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full text-center border-collapse">
                <thead>
                    <tr class="bg-surface-container-low border-b border-outline-variant">
                        <th class="px-6 py-3 text-sm text-on-surface-variant uppercase tracking-wider text-center">Fecha y hora</th>
                        <th class="px-6 py-3 text-sm text-on-surface-variant uppercase tracking-wider text-center">Actor</th>
                        <th class="px-6 py-3 text-sm text-on-surface-variant uppercase tracking-wider text-center">Módulo</th>
                        <th class="px-6 py-3 text-sm text-on-surface-variant uppercase tracking-wider text-center">Acción</th>
                        <th class="px-6 py-3 text-sm text-on-surface-variant uppercase tracking-wider text-center">Detalle</th>
                        <th class="px-6 py-3 text-sm text-on-surface-variant uppercase tracking-wider text-center">Resultado</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-outline-variant">
                    @foreach (var r in Model.Registros)
                    {
                        <tr class="data-row">
                            <td class="px-6 py-3.5 font-mono text-sm whitespace-nowrap">@r.FechaHora.ToString("dd/MM/yyyy HH:mm:ss")</td>
                            <td class="px-6 py-3.5 font-mono text-sm text-on-surface-variant">@r.Actor</td>
                            <td class="px-6 py-3.5">
                                <span class="status-pill bg-surface-container text-on-surface-variant">@r.Modulo</span>
                            </td>
                            <td class="px-6 py-3.5 font-medium">@r.Accion</td>
                            <td class="px-6 py-3.5 text-on-surface-variant">@r.Detalle</td>
                            <td class="px-6 py-3.5">
                                <span class="status-pill @ClaseResultado(r.Resultado)">@r.Resultado</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
