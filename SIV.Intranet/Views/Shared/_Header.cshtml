@{
    // El título y subtítulo los define cada vista vía ViewData.
    var titulo = ViewData["Title"]?.ToString() ?? "Panel";
    var subtitulo = ViewData["Subtitulo"]?.ToString() ?? "Sistema de Información de Vuelos";
    var rol = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    var inicial = string.IsNullOrEmpty(User.Identity?.Name) ? "?" : User.Identity!.Name!.Substring(0, 1).ToUpper();
}
<header class="w-full h-20 px-8 flex justify-between items-center bg-surface sticky top-0 z-40 border-b border-outline-variant">
    <div>
        <h2 class="text-xl font-bold text-primary">@titulo</h2>
        <p class="text-sm text-on-surface-variant">@subtitulo</p>
    </div>
    <div class="flex items-center gap-3 bg-surface-container-low px-3 py-2 rounded-full">
        <div class="w-10 h-10 rounded-full bg-primary text-on-primary flex items-center justify-center font-bold">@inicial</div>
        <div class="flex flex-col pr-2">
            <span class="text-sm font-bold text-on-surface leading-none">@User.Identity?.Name</span>
            <span class="text-[10px] text-on-surface-variant uppercase tracking-wider">@rol</span>
        </div>
    </div>
</header>
