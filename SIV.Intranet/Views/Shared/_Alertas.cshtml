@*
    Muestra los mensajes de resultado de la última operación.
    Incluido en el layout para que cualquier pantalla los aproveche (DRY).
*@
@if (TempData["Exito"] is string exito)
{
    <div class="flex items-center gap-2 bg-green-50 text-green-800 border border-green-200 rounded-lg px-4 py-3">
        <span class="material-symbols-outlined">check_circle</span>
        <span>@exito</span>
    </div>
}

@if (TempData["Error"] is string error)
{
    <div class="flex items-center gap-2 bg-red-50 text-secondary border border-red-200 rounded-lg px-4 py-3">
        <span class="material-symbols-outlined">error</span>
        <span>@error</span>
    </div>
}
