@using System.Security.Claims
@model IReadOnlyList<SIV.Intranet.Models.UsuarioApi>
@{
    ViewData["Title"] = "Usuarios";
    ViewData["Subtitulo"] = "Personal del sistema";

    // Id del usuario en sesión: se usa para no ofrecerle eliminar su propia cuenta.
    var miId = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

    // Color del distintivo según el rol, para leer la tabla de un vistazo.
    string ClaseRol(string rol) => rol switch
    {
        "Administrador" => "bg-primary/10 text-primary",
        "OperadorVuelos" => "bg-sky-100 text-sky-700",
        "Auditor" => "bg-amber-100 text-amber-700",
        _ => "bg-surface-container text-on-surface-variant"
    };
}

<div class="bg-surface-container-lowest border border-outline-variant rounded-xl shadow-sm overflow-hidden">
    <div class="p-6 border-b border-outline-variant flex justify-between items-center">
        <div>
            <h3 class="text-lg font-bold text-primary">Usuarios del sistema</h3>
            <p class="text-sm text-on-surface-variant">Personal interno y usuarios registrados</p>
        </div>
        <a asp-action="Crear"
           class="flex items-center gap-1 px-4 py-2 bg-primary text-on-primary rounded-lg text-sm hover:opacity-90 transition-all">
            <span class="material-symbols-outlined text-sm">person_add</span> Nuevo usuario
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="p-8 text-center text-on-surface-variant">No hay usuarios registrados.</div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-surface-container-low border-b border-outline-variant">
                        <th class="px-6 py-3 text-sm text-on-surface-variant uppercase tracking-wider">Nombre</th>
                        <th class="px-6 py-3 text-sm text-on-surface-variant uppercase tracking-wider">Correo</th>
                        <th class="px-6 py-3 text-sm text-on-surface-variant uppercase tracking-wider">Rol</th>
                        <th class="px-6 py-3 text-sm text-on-surface-variant uppercase tracking-wider">Creado</th>
                        <th class="px-6 py-3 text-sm text-on-surface-variant uppercase tracking-wider text-right">Acciones</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-outline-variant">
                    @foreach (var u in Model.OrderBy(u => u.Nombre))
                    {
                        <tr class="data-row">
                            <td class="px-6 py-3.5 font-semibold text-on-surface">@u.Nombre</td>
                            <td class="px-6 py-3.5 font-mono text-sm text-on-surface-variant">@u.Email</td>
                            <td class="px-6 py-3.5">
                                <span class="status-pill @ClaseRol(u.Rol)">@u.Rol</span>
                            </td>
                            <td class="px-6 py-3.5 font-mono text-sm text-on-surface-variant">@u.CreadoEn.AHoraLocal().ToString("dd/MM/yyyy")</td>
                            <td class="px-6 py-3.5 text-right">
                                @if (miId == u.Id.ToString())
                                {
                                    <span class="text-xs text-on-surface-variant italic">Tu cuenta</span>
                                }
                                else
                                {
                                    @* Borrado permanente: la confirmación deja claro que no es reversible. *@
                                    <form asp-action="Eliminar" method="post" class="inline"
                                          onsubmit="return confirm('¿Eliminar de forma permanente la cuenta de @u.Nombre (@u.Email)? Esta acción no se puede deshacer.');">
                                        <input type="hidden" name="id" value="@u.Id" />
                                        <button type="submit" class="inline-flex items-center gap-1 text-secondary hover:underline text-sm">
                                            <span class="material-symbols-outlined text-base">delete</span> Eliminar
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="px-6 py-3 bg-surface-container-low border-t border-outline-variant text-sm text-on-surface-variant">
            @Model.Count usuario(s)
        </div>
    }
</div>
