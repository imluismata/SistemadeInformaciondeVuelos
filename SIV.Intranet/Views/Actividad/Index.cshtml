@model SIV.Intranet.Models.ActividadViewModel
@{
    ViewData["Title"] = "Actividad de usuarios";
    ViewData["Subtitulo"] = "Seguimientos y notificaciones del sistema";

    string ClaseEstadoSeg(string estado) => estado.Equals("Activo", StringComparison.OrdinalIgnoreCase)
        ? "bg-green-100 text-green-700" : "bg-gray-100 text-gray-600";

    string ClaseEstadoNot(string estado) => estado.Equals("Leida", StringComparison.OrdinalIgnoreCase)
        ? "bg-gray-100 text-gray-600" : "bg-sky-100 text-sky-700";
}

<!-- CU-SEG-04: Historial de seguimientos -->
<div class="bg-surface-container-lowest border border-outline-variant rounded-xl shadow-sm overflow-hidden">
    <div class="p-6 border-b border-outline-variant flex justify-between items-center">
        <div>
            <h3 class="text-lg font-bold text-primary">Seguimientos</h3>
            <p class="text-sm text-on-surface-variant">Quién sigue qué vuelo · @Model.Seguimientos.Count registro(s)</p>
        </div>
        <span class="flex items-center gap-1 text-xs text-on-surface-variant">
            <span class="material-symbols-outlined text-sm">lock</span> Solo lectura
        </span>
    </div>
    @if (!Model.Seguimientos.Any())
    {
        <div class="p-8 text-center text-on-surface-variant">No hay seguimientos registrados.</div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-surface-container-low border-b border-outline-variant">
                        <th class="px-6 py-3 text-sm text-on-surface-variant uppercase tracking-wider">Usuario</th>
                        <th class="px-6 py-3 text-sm text-on-surface-variant uppercase tracking-wider">Vuelo</th>
                        <th class="px-6 py-3 text-sm text-on-surface-variant uppercase tracking-wider">Estado</th>
                        <th class="px-6 py-3 text-sm text-on-surface-variant uppercase tracking-wider">Desde</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-outline-variant">
                    @foreach (var s in Model.Seguimientos)
                    {
                        <tr class="data-row">
                            <td class="px-6 py-3 font-mono text-sm text-on-surface-variant">@s.Usuario</td>
                            <td class="px-6 py-3 font-mono font-semibold text-primary">@s.Vuelo</td>
                            <td class="px-6 py-3"><span class="status-pill @ClaseEstadoSeg(s.Estado)">@s.Estado</span></td>
                            <td class="px-6 py-3 font-mono text-sm whitespace-nowrap">@s.CreadoEn.AHoraLocal().ToString("dd/MM/yyyy HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- CU-NOT-04: Registro de notificaciones -->
<div class="bg-surface-container-lowest border border-outline-variant rounded-xl shadow-sm overflow-hidden">
    <div class="p-6 border-b border-outline-variant flex justify-between items-center">
        <div>
            <h3 class="text-lg font-bold text-primary">Notificaciones</h3>
            <p class="text-sm text-on-surface-variant">Qué se notificó y a quién · @Model.Notificaciones.Count registro(s)</p>
        </div>
        <span class="flex items-center gap-1 text-xs text-on-surface-variant">
            <span class="material-symbols-outlined text-sm">lock</span> Solo lectura
        </span>
    </div>
    @if (!Model.Notificaciones.Any())
    {
        <div class="p-8 text-center text-on-surface-variant">No hay notificaciones registradas.</div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-surface-container-low border-b border-outline-variant">
                        <th class="px-6 py-3 text-sm text-on-surface-variant uppercase tracking-wider">Fecha</th>
                        <th class="px-6 py-3 text-sm text-on-surface-variant uppercase tracking-wider">Destinatario</th>
                        <th class="px-6 py-3 text-sm text-on-surface-variant uppercase tracking-wider">Mensaje</th>
                        <th class="px-6 py-3 text-sm text-on-surface-variant uppercase tracking-wider">Estado</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-outline-variant">
                    @foreach (var n in Model.Notificaciones)
                    {
                        <tr class="data-row">
                            <td class="px-6 py-3 font-mono text-sm whitespace-nowrap">@n.GeneradaEn.AHoraLocal().ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="px-6 py-3 font-mono text-sm text-on-surface-variant">@n.Usuario</td>
                            <td class="px-6 py-3">@n.Mensaje</td>
                            <td class="px-6 py-3"><span class="status-pill @ClaseEstadoNot(n.Estado)">@n.Estado</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
