@model SIV.Intranet.Models.TerminalViewModel
@{
    var titulo = Model.EsEdicion ? "Editar terminal" : "Nueva terminal";
    ViewData["Title"] = titulo;
    ViewData["Subtitulo"] = "Catálogo aeroportuario";
}

<div class="bg-surface-container-lowest border border-outline-variant rounded-xl shadow-sm overflow-hidden max-w-xl">
    <div class="p-6 border-b border-outline-variant">
        <h3 class="text-lg font-bold text-primary">@titulo</h3>
        <p class="text-sm text-on-surface-variant">El código debe ser único dentro de su aeropuerto.</p>
    </div>

    <form asp-action="Terminal" method="post" class="p-6 space-y-5">
        <div asp-validation-summary="ModelOnly" class="text-sm text-secondary bg-red-50 border border-red-200 rounded-lg px-4 py-3"></div>
        <input type="hidden" asp-for="Id" />

        <div>
            <label asp-for="Codigo" class="block text-sm font-medium text-on-surface-variant mb-1"></label>
            <input asp-for="Codigo" placeholder="Ej. A"
                   class="w-full rounded-lg border border-outline-variant px-4 py-2.5 focus:ring-2 focus:ring-primary-container outline-none" />
            <span asp-validation-for="Codigo" class="text-xs text-secondary"></span>
        </div>

        <div>
            <label asp-for="Nombre" class="block text-sm font-medium text-on-surface-variant mb-1"></label>
            <input asp-for="Nombre" placeholder="Ej. Terminal A"
                   class="w-full rounded-lg border border-outline-variant px-4 py-2.5 focus:ring-2 focus:ring-primary-container outline-none" />
            <span asp-validation-for="Nombre" class="text-xs text-secondary"></span>
        </div>

        @* El aeropuerto solo se elige al crear: una terminal no se muda de aeropuerto. *@
        @if (Model.EsEdicion)
        {
            <input type="hidden" asp-for="AeropuertoId" />
        }
        else
        {
            <div>
                <label asp-for="AeropuertoId" class="block text-sm font-medium text-on-surface-variant mb-1"></label>
                <select asp-for="AeropuertoId" asp-items="Model.Aeropuertos"
                        class="w-full rounded-lg border border-outline-variant px-4 py-2.5 focus:ring-2 focus:ring-primary-container outline-none">
                    <option value="">— Selecciona el aeropuerto —</option>
                </select>
                <span asp-validation-for="AeropuertoId" class="text-xs text-secondary"></span>
            </div>
        }

        <div class="flex gap-3 pt-2">
            <button type="submit" class="bg-primary text-on-primary rounded-lg px-6 py-2.5 font-semibold hover:opacity-90 transition-opacity">
                Guardar
            </button>
            <a asp-action="Index" class="border border-outline text-on-surface rounded-lg px-6 py-2.5 font-semibold hover:bg-surface-container transition-colors">
                Cancelar
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
